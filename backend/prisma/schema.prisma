generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  passwordHash  String
  nama          String
  role          String
  bidang        String?
  noWa          String?
  createdAt     DateTime @default(now())

  agendaCreated       AgendaKegiatan[] @relation("AgendaCreatedBy")
  agendaPeserta       AgendaPeserta[]
  suratCreated        SuratMasuk[]     @relation("SuratCreatedBy")
  disposisiCreated    Disposisi[]      @relation("DisposisiCreatedBy")
  delegasiCreated     Delegasi[]       @relation("DelegasiCreatedBy")
  tindakLanjutCreated TindakLanjut[]   @relation("TindakLanjutCreatedBy")
}

model AgendaKegiatan {
  id             Int       @id @default(autoincrement())
  tanggalMulai   DateTime
  tanggalSelesai DateTime?
  jamMulai       String
  jamSelesai     String?
  acara          String    @db.Text
  tempat         String
  undanganDari   String
  fileUndangan   String?
  keterangan     String?   @db.Text
  createdById    Int
  createdBy      User      @relation("AgendaCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())

  peserta         AgendaPeserta[]
  notulen         Notulen?
  rencanaLanjutan RencanaLanjutan?
}

model AgendaPeserta {
  id       Int            @id @default(autoincrement())
  agendaId Int
  agenda   AgendaKegiatan @relation(fields: [agendaId], references: [id])
  userId   Int
  user     User           @relation(fields: [userId], references: [id])
}

model SuratMasuk {
  id                   Int       @id @default(autoincrement())
  noUrut               Int
  tglTerima            DateTime
  tglSurat             DateTime
  noSurat              String?
  hal                  String    @db.Text
  asalSurat            String
  sifat                String    @default("(-) Tidak ada")
  fileUtama            String?
  deadlineTindakLanjut DateTime?
  keteranganAdmin      String?   @db.Text
  status               String    @default("draft") // draft, submitted, menunggu_disposisi, proses, selesai
  createdById          Int
  createdBy            User      @relation("SuratCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime  @default(now())

  lampiran   SuratLampiran[]
  disposisi  Disposisi[]
}

model SuratLampiran {
  id       Int        @id @default(autoincrement())
  suratId  Int
  surat    SuratMasuk @relation(fields: [suratId], references: [id])
  filePath String
}

model Disposisi {
  id                Int        @id @default(autoincrement())
  suratId           Int
  surat             SuratMasuk @relation(fields: [suratId], references: [id])
  instruksi         String     @db.Text // JSON string array
  instruksiTambahan String?    @db.Text
  uraian            String?    @db.Text
  deadline          DateTime?
  bidangTujuan      String     @db.Text // JSON string array, contoh: ["PPM","PSDA"]
  createdById       Int
  createdBy         User       @relation("DisposisiCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime   @default(now())

  delegasi     Delegasi[]
  tindakLanjut TindakLanjut?
}

model Delegasi {
  id                 Int       @id @default(autoincrement())
  disposisiId        Int
  disposisi          Disposisi @relation(fields: [disposisiId], references: [id])
  pelaksanaIds       String    @db.Text // JSON string array of user id
  dikerjakanLangsung Boolean   @default(false)
  createdById        Int
  createdBy          User      @relation("DelegasiCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
}

model TindakLanjut {
  id                 Int       @id @default(autoincrement())
  disposisiId        Int       @unique
  disposisi          Disposisi @relation(fields: [disposisiId], references: [id])
  uraianPekerjaan    String    @db.Text
  buktiFiles         String?   @db.Text
  sudahDisubmit      Boolean   @default(false)
  hasilVerifikasi    String?
  catatanVerifikasi  String?   @db.Text
  createdById        Int
  createdBy          User      @relation("TindakLanjutCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Notulen {
  id             Int            @id @default(autoincrement())
  agendaId       Int            @unique
  agenda         AgendaKegiatan @relation(fields: [agendaId], references: [id])
  catatan        String         @db.Text
  file           String?
  terkunci       Boolean        @default(false)
  requestEdit    Boolean        @default(false)
  alasanEdit     String?        @db.Text
  createdAt      DateTime       @default(now())
}

model RencanaLanjutan {
  id        Int            @id @default(autoincrement())
  agendaId  Int            @unique
  agenda    AgendaKegiatan @relation(fields: [agendaId], references: [id])
  uraian    String         @db.Text
  pic       String?
  deadline  DateTime?
  createdAt DateTime       @default(now())
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  namaUser   String
  role       String   @default("Unknown")
  aktivitas  String   @db.Text
  createdAt  DateTime @default(now())
}